{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "OpenTelemetryExample",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ConnectionStrings": {
    "LogsDatabase": "Server=localhost;Database=YourDatabase;User Id=sa;Password=YourPassword;TrustServerCertificate=true;"
  },
  "LogMigration": {
    "Enabled": false,
    "LokiUrl": "http://localhost:3100",
    "BatchSize": 1000,
    "MigrateAuditTrail": true,
    "MigrateApiLogs": true
  }
}
